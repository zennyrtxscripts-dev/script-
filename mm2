local dragStart, startPos
btn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragStart = UIS:GetMouseLocation()
		startPos = btn.Position
	end
end)
UIS.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement and dragStart then
		local delta = UIS:GetMouseLocation() - dragStart
		btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		menu.Position = UDim2.new(btn.Position.X.Scale, btn.Position.X.Offset + 60, btn.Position.Y.Scale, btn.Position.Y.Offset)
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then dragStart = nil end
end)

btn.MouseButton1Click:Connect(function()
	menu.Visible = not menu.Visible
end)

coinBtn.MouseButton1Click:Connect(function()
	active = not active
	coinBtn.BackgroundColor3 = active and Color3.fromRGB(0,160,0) or Color3.fromRGB(180,0,0)
	if active then
		task.spawn(loop)
	else
		currentTarget = nil
		setFly(false)
	end
end)

PlayerGui.ChildRemoved:Connect(function(c)
	if c == btn or c == menu then active = false end
end)

notify("Script carregado com sucesso")
  
